/*
 * 34-key layout ported from the X.Tips V4s QMK/Vial keymap.
 * Callum-style oneshot mods -> sticky keys with quick-release.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define FNC  3
#define SYS  4

// The shortcut the lang key taps out, matching what macOS' Keyboard settings
// have under "Select the next source in the Input menu".
#define LANG_SWITCH LC(LA(SPACE))

&caps_word {
    // Match QMK's caps word, which also survives Backspace and Delete.
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

&sk {
    // Stackable mods that are consumed by the first following keypress.
    ignore-modifiers;
    quick-release;
    // The QMK original never timed out; 5s is the safety net backing up the
    // K_CANCEL panic key that replaces its cancel-on-layer-key.
    release-after-ms = <5000>;
};

/ {
    behaviors {
        // Hold: FNC layer, tap: input language switch. Sits on the opposite
        // thumb key of NAV and NUM, so FNC is a both-thumbs chord.
        lng: lang_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // Shift+Backspace sends a bare Delete; Delete is on no layer.
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
            &kp Q &kp W &kp E &kp R &kp T                            &kp Y &kp U &kp I     &kp O   &kp P
            &kp A &kp S &kp D &kp F &kp G                            &kp H &kp J &kp K     &kp L   &kp SEMI
            &kp Z &kp X &kp C &kp V &kp B                            &kp N &kp M &kp COMMA &kp DOT &kp FSLH
                              &mo NAV &kp SPACE            &kp RET &mo NUM
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
            &kp ESC   &none     &none    &key_repeat &kp K_CANCEL     &kp HOME  &kp PG_DN &kp PG_UP &kp END   &none
            &sk LCTRL &sk LALT  &sk LGUI &sk LSHIFT  &caps_word       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans
            &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V)  &none            &bspc_del &kp TAB   &trans    &trans    &trans
                                &trans &none                &trans &lng FNC LANG_SWITCH
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
            &kp N1    &kp N2   &kp N3   &kp N4     &kp N5             &kp N6    &kp N7    &kp N8   &kp N9   &kp N0
            &sk LCTRL &sk LALT &sk LGUI &sk LSHIFT &kp BSLH           &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp SQT
            &none     &none    &none    &none      &none              &bspc_del &kp TAB   &kp COMMA &kp DOT &kp GRAVE
                               &lng FNC LANG_SWITCH &trans            &none &trans
            >;
        };

        // Function & media, reached by holding both outer thumb keys.
        // The bottom-right key opens the SYS layer on top while held.
        fnc_layer {
            display-name = "Fn";
            bindings = <
            &kp F1       &kp F2       &kp F3       &kp F4       &kp F5              &kp F6     &kp F7         &kp F8    &kp F9       &kp F10
            &sk LCTRL    &sk LALT     &sk LGUI     &sk LSHIFT   &none               &kp F11    &kp F12        &kp C_PP  &kp C_VOL_DN &kp C_VOL_UP
            &none        &none        &none        &none        &none               &none      &none          &none     &none        &mo SYS
                                      &trans &none                &none &trans
            >;
        };

        // Bluetooth and bootloader, deliberately three keys deep
        // (NAV + lng + '/') so a slip on the Fn layer can't reach them.
        // Momentary: release '/' and it's gone. The right pinky holds '/',
        // so the right-hand keys sit by the inner edge.
        sys_layer {
            display-name = "Sys";
            bindings = <
            &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4        &bt BT_CLR &studio_unlock &bootloader &none &none
            &none        &none        &none        &none        &none               &none      &none          &none       &none &none
            &none        &none        &none        &none        &none               &none      &none          &none       &none &trans
                                      &none &none                &none &none
            >;
        };
    };
};
